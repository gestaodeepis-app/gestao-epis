rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logged() {
      return request.auth != null;
    }

    function userExists() {
      return logged() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return userExists() && userDoc().status == "ATIVO";
    }

    function isOwner() {
      return active() && (userDoc().isOwner == true || userDoc().role == "PROPRIETARIO");
    }

    function isAdmin() {
      return active() && (isOwner() || userDoc().role == "ADMINISTRADOR");
    }

    function isSSMA() {
      return active() && (isAdmin() || userDoc().role == "SSMA");
    }

    function isViewer() {
      return active() && (isSSMA() || userDoc().role == "VISUALIZADOR");
    }

    function samePlant(plantId) {
      return isAdmin() || userDoc().plantId == plantId || userDoc().plantId == "TODAS";
    }

    match /system/{doc} {
      allow read, write: if isOwner();
    }

    match /settings/{doc} {
      allow read: if active();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if active() && (uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /plants/{plantId} {
      allow read: if active();
      allow create, update, delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isViewer();
      allow create, update: if isSSMA() && samePlant(request.resource.data.plantId);
      allow delete: if isAdmin();
    }

    match /epis/{epiId} {
      allow read: if isViewer();
      allow create, update: if isSSMA();
      allow delete: if isAdmin();
    }

    match /stock/{stockId} {
      // Coleção antiga mantida somente para compatibilidade com versões anteriores.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /movements/{movementId} {
      allow read: if isViewer();

      allow create: if isSSMA()
        && samePlant(request.resource.data.plantId);

      allow update: if isSSMA()
        && samePlant(resource.data.plantId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['signatureStatus', 'signatureUpdatedAt', 'signatureUpdatedBy']);

      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if active();
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if active();
      allow create, update: if isSSMA();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
