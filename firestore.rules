rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logged(){ return request.auth != null; }
    function userExists(){ return logged() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function currentUser(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active(){ return userExists() && currentUser().status == "ATIVO"; }
    function isOwner(){ return active() && (currentUser().isOwner == true || currentUser().role == "PROPRIETARIO"); }
    function isAdmin(){ return active() && (isOwner() || currentUser().role == "ADMINISTRADOR"); }
    function isSSMA(){ return active() && (isAdmin() || currentUser().role == "SSMA"); }
    function isViewer(){ return active() && (isSSMA() || currentUser().role == "VISUALIZADOR"); }
    function samePlant(plantId){ return isAdmin() || currentUser().plantId == "TODAS" || currentUser().plantId == plantId; }

    match /system/{document} { allow read, write: if isOwner(); }
    match /settings/{document} { allow read: if active(); allow create, update, delete: if isAdmin(); }

    match /users/{uid} {
      allow read: if logged() && (request.auth.uid == uid || isOwner());

      allow create: if logged()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','status','role','plantId','isOwner','photoUrl','createdAt','requestedAt','hierarchyVersion'])
        && request.resource.data.status == "PENDENTE"
        && request.resource.data.role == ""
        && request.resource.data.plantId == ""
        && request.resource.data.isOwner == false
        && request.resource.data.email == request.auth.token.email;

      allow update: if isOwner()
        || (
          request.auth.uid == uid
          && resource.data.status == "ATIVO"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl','lastSeenAt','lastSeenDevice','updatedAt','updatedBy'])
        );

      allow delete: if isOwner();
    }

    match /plants/{plantId} {
      allow read: if active() && (isAdmin() || currentUser().plantId == "TODAS" || currentUser().plantId == plantId);
      allow create, update, delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isViewer() && samePlant(resource.data.plantId);
      allow create: if isSSMA() && samePlant(request.resource.data.plantId);
      allow update: if isSSMA() && samePlant(resource.data.plantId) && samePlant(request.resource.data.plantId);
      allow delete: if isAdmin();
    }

    match /epis/{epiId} {
      allow read: if isViewer() && samePlant(resource.data.plantId);
      allow create: if isSSMA() && samePlant(request.resource.data.plantId);
      allow update: if isSSMA() && samePlant(resource.data.plantId) && samePlant(request.resource.data.plantId);
      allow delete: if isAdmin();
    }

    match /stock/{stockId} { allow read: if isAdmin(); allow write: if false; }

    match /movements/{movementId} {
      allow read: if isViewer() && samePlant(resource.data.plantId);
      allow create: if isSSMA() && samePlant(request.resource.data.plantId);
      allow update: if isSSMA() && samePlant(resource.data.plantId) && samePlant(request.resource.data.plantId);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if active();
      allow delete: if isOwner();
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read: if active();
      allow create, update: if isSSMA();
      allow delete: if isAdmin();
    }

    // Estado de leitura das notificações por usuário.
    // Permite sincronizar "lida/não lida" entre celular, PC e PWA.
    match /notificationStates/{uid} {
      allow read: if active() && request.auth.uid == uid;

      allow create, update: if active()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['readKeys','updatedAt'])
        && request.resource.data.readKeys is list
        && request.resource.data.readKeys.size() <= 500;

      allow delete: if active() && request.auth.uid == uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
